# Copy to .env and adjust. Never commit .env.
POSTGRES_PASSWORD=change-me

# External URL (used for cookies, the setup link and MCP host validation)
TESTAPP_PUBLIC_URL=http://localhost:8080
TESTAPP_PORT=8080

# CIDRs of reverse proxies whose X-Forwarded-For header is trusted
TESTAPP_TRUSTED_PROXIES=

# Optional: create this admin on first start. Otherwise a one-time setup link
# is written to the log.
TESTAPP_ADMIN_EMAIL=
TESTAPP_ADMIN_PASSWORD=

# Also log read access (viewing/searching notes and users): true | false
TESTAPP_AUDIT_READS=true
# Delete audit entries after this many days (0 = keep forever)
TESTAPP_AUDIT_RETENTION_DAYS=90

# Size of the database connection pool
TESTAPP_DB_MAX_CONNECTIONS=20

# text | json
TESTAPP_LOG_FORMAT=json
RUST_LOG=info,tower_http=info,sqlx=warn
